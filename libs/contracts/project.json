{
  "name": "contracts",
  "projectType": "library",
  "sourceRoot": "libs/contracts/src",
  "tags": ["scope:shared"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/contracts/tsconfig.json"
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/contracts/tsconfig.json --noEmit"
      }
    },
    "test": {
      "options": {
        "command": "vitest run"
      }
    }
  }
}
